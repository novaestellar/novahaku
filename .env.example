# Novahaku Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration (for test harness)
NOVAHAKU_API_URL=http://localhost:20128/v1/chat/completions
NOVAHAKU_API_KEY=your-api-key-here

# Optional: Custom model endpoint
# NOVAHAKU_MODEL_ENDPOINT=https://api.openai.com/v1

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# NOVAHAKU_LOG_LEVEL=INFO

# ============================================================
# RE Tool Paths (update to match your installation)
# ============================================================

# Ghidra
# Linux/macOS: /opt/ghidra/
# Windows: C:\tools\ghidra\
GHIDRA_HOME=/opt/ghidra
GHIDRA_ANALYZE_HEADLESS=$GHIDRA_HOME/support/analyzeHeadless

# IDA Pro
# Read by start-idapro.ps1/.sh when launching IDA or the idalib MCP supervisor.
# Linux/macOS: /opt/ida/
# Windows: C:\Program Files\IDA Professional 9.0\
IDA_HOME=/opt/ida

# radare2
# Linux/macOS: /usr/local/bin/r2
# Windows: C:\tools\radare2\bin\r2.exe
RADARE2_HOME=/usr/local/bin
R2=$RADARE2_HOME/r2

# jadx (Android decompiler)
# Linux/macOS: /opt/jadx/bin/
# Windows: C:\tools\jadx\bin\
JADX_HOME=/opt/jadx/bin
JADX=$JADX_HOME/jadx

# apktool
# Linux/macOS: /opt/apktool/
# Windows: C:\tools\apktool\
APKTOOL_HOME=/opt/apktool
APKTOOL=$APKTOOL_HOME/apktool.jar

# Frida (pip installed)
FRIDA_HOME=$(python3 -c "import frida; import os; print(os.path.dirname(frida.__file__))" 2>/dev/null || echo "/usr/local/lib/python3/dist-packages/frida")

# YARA
# Linux/macOS: /usr/local/bin/yara
# Windows: C:\tools\yara\
YARA_HOME=/usr/local/bin

# Hashcat (pip or system install)
# Hashcat: installed via pip or package manager, available in PATH

# SecLists
# Linux/macOS: /opt/SecLists
# Windows: C:\tools\SecLists\
SECLISTS_HOME=/opt/SecLists

# ============================================================
# MCP Server Ports
# ============================================================

# BurpSuite MCP (stdio via bridge)
BURPSUITE_MCP_PORT=9876

# Anything Analyzer MCP (remote)
ANYTHING_ANALYZER_MCP_PORT=23816
# Bearer token for the Anything Analyzer MCP endpoint. Read by
# bootstrap-reverse.ps1 when it wires the MCP client config. Leave empty when
# the server runs without auth; never commit a real value here.
ANYTHING_ANALYZER_MCP_TOKEN=

# Binary Ninja MCP (remote, served natively by the Binary Ninja UI plugin)
BINARY_NINJA_MCP_PORT=24642

# IDA Pro MCP (remote, served by the IDA plugin once a database is open)
IDAPRO_MCP_PORT=13337
# Headless idalib MCP server port, when running the idalib supervisor instead
# of the GUI plugin.
IDAPRO_HEADLESS_MCP_PORT=8745

# GhidraMCP — same tool surface over two transports (pick one)
#   headless: com.xebyte.headless.GhidraMCPHeadlessServer, REST, no GUI needed
#   GUI:      GhidraMCP plugin panel, native MCP
# Do NOT use 8080 — that is the Burp proxy listener by default.
GHIDRA_MCP_PORT=8089

# ============================================================
# Python Dependencies (install with pip)
# ============================================================
# Required:
#   pip install pycryptodome requests openpyxl
# Optional (for advanced features):
#   pip install curl_cffi      # TLS fingerprint (api_farm.py)
#   pip install playwright     # Browser automation (api_farm.py)
#   pip install camoufox       # Turnstile solving (api_farm.py)


# === CI/CD Workflow Scanner (hunt-cicd) ===
# GitHub PAT for workflow_vuln_scan.py (repo:scope read-only is sufficient)
GITHUB_TOKEN=""
# Dependencies: pip install PyGithub PyYAML

# ============================================================
# Skill Root Overrides
# ============================================================
# Every script resolves paths relative to its own location, so the values
# below only need to be set when your install layout differs.
# NEVER hardcode absolute paths inside a script — use one of these instead.

# novahaku skill root (leave empty to auto-detect from the script's location)
# NOVAHAKU_HOME=/path/to/novahaku

# Python interpreter for the Windows test suite (empty = "python" on PATH)
# NOVAHAKU_PYTHON=python

# Engagement working directory (empty = <skill_root>/engagements)
# findings_gen.py and engagement.py read this variable
# NOVAHAKU_ENGAGEMENT_DIR=/path/to/engagements

# Web scanner cache directory (empty = <skill_root>/testing/scripts)
# NOVAHAKU_SCAN_CACHE_DIR=/path/to/cache

# Sibling novaxinwei checkout. Read by testing/pipeline/test_pipeline_chain.py
# when the two repos are not siblings on disk.
# NOVAXINWEI_ROOT=/path/to/novaxinwei

# MCP client config paths, when the client stores them outside the usual
# per-user location. Read by scripts/reverse-skill/lib/ToolDiscovery.ps1.
# CLAUDE_MCP_CONFIG=/path/to/.claude.json
# CODEX_CONFIG_PATH=/path/to/codex-config.toml

# ============================================================
# Integration & Runtime Overrides
# ============================================================

# Hermes install root. Read by scripts/hermes-patch/hermes_patch.py to locate
# the agent tree it patches. Leave empty to use the tool's own auto-detection.
# HERMES_HOME=/path/to/.hermes

# Directory containing the hermes-agent tools/ folder. Takes precedence over
# HERMES_HOME when set.
# HERMES_AGENT_HOME=/path/to/hermes-agent

# Hermes skills root. Read by testing/runtime/rt_v4.py; empty falls back to
# walking up from the script's own location.
# HERMES_SKILLS_ROOT=/path/to/hermes/skills

# Model API base URL and model name for reframe/reframe_cli.py. Both are
# separate from NOVAHAKU_API_URL above.
# NOVAHAKU_API_BASE=https://api.example.com/v1
# NOVAHAKU_MODEL=your-model-name

# Set to 1 to let train/train.py send live model requests. Any other value
# (including unset) makes it print a HOLD notice and exit without sending.
# NOVAHAKU_TRAIN_CONFIRM=1

# bash used by scripts/reverse-skill/test-routing.sh. Empty = the bash already
# running the script, then PATH lookup. Set explicitly when the default bash is
# a WSL stub rather than a real shell.
# BASH_BIN=/usr/bin/bash

# GitHub token for scripts/reverse-skill/update-star-history.ps1. GITHUB_TOKEN
# above is used as the fallback. Requires repo admin/collaborator access.
# GH_TOKEN=

# Supabase project URL and anon/service key. Read by
# testing/frameworks/supabase-app-security-audit/scripts/supabase_rest_dump.py.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=

# Where test-bootstrap-supply-chain.ps1 writes its transcript. Empty = temp.
# BOOTSTRAP_PS_LOG=/path/to/bootstrap-supply-chain.log

# ============================================================
# Referenced Tool Roots (leave empty when the tool is on PATH)
# ============================================================
# The tools above (GHIDRA_HOME, SECLISTS_HOME, etc.) use Linux example values.
# Windows users: substitute your own install paths.
# Windows example (never commit your real values to a public repo):
#   GHIDRA_HOME=C:\tools\ghidra
#   SECLISTS_HOME=C:\tools\SecLists
#   JADX_HOME=C:\tools\jadx\bin
#   IDA_HOME=C:\Program Files\IDA Professional 9.0
#   APKTOOL_HOME=C:\tools\apktool
#   RADARE2_HOME=C:\tools\radare2\bin
