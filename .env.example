# Novahaku Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration (for test harness)
NOVAHAKU_API_URL=http://localhost:20128/v1/chat/completions
NOVAHAKU_API_KEY=your-api-key-here

# Optional: Custom model endpoint
# NOVAHAKU_MODEL_ENDPOINT=https://api.openai.com/v1

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# NOVAHAKU_LOG_LEVEL=INFO

# ============================================================
# RE Tool Paths (update to match your installation)
# ============================================================

# Ghidra
GHIDRA_HOME=C:\Users\Design\Tools\ghidra_12.1.2_PUBLIC
GHIDRA_ANALYZE_HEADLESS=%GHIDRA_HOME%\support\analyzeHeadless.bat

# radare2
RADARE2_HOME=C:\Users\Design\Tools\radare2\bin
R2=%RADARE2_HOME%\r2.exe

# jadx (Android decompiler)
JADX_HOME=C:\Users\Design\Tools\jadx\bin
JADX=%JADX_HOME%\jadx.bat

# apktool
APKTOOL_HOME=C:\Users\Design\Tools\apktool
APKTOOL=%APKTOOL_HOME%\apktool.jar

# Frida
FRIDA_HOME=C:\Users\Design\AppData\Local\Programs\Python\Python313\Scripts
FRIDA=%FRIDA_HOME%\frida.exe

# YARA
YARA_HOME=C:\Users\Design\Tools\yara

# Hashcat
# Hashcat: installed via pip, available in PATH

# ============================================================
# MCP Server Ports
# ============================================================

# BurpSuite MCP (stdio via bridge)
BURPSUITE_MCP_PORT=9876

# Anything Analyzer MCP (remote)
ANYTHING_ANALYZER_MCP_PORT=23816

# pentest-ai
PENTEST_AI_PATH=D:\pinokio\opencode-venvs\pentest-ai-env\Scripts\ptai.exe
