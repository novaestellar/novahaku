# Runtime
runs/
*.pid

# Test results
webtest_results.json
webtest_results.json.racelock
training_results.json
testing/**/engagements/

# Engagement runtime data - per-target state, evidence, and findings never ship.
# The TEMPLATE ships so the layout stays documented and git-tracked.
engagements/*
!engagements/TEMPLATE
engagements/**/evidence/
engagements/**/report.md
engagements/**/candidates.json
engagements/**/recon.json
engagements/**/.lock

# Engagement/scan artifacts that can carry target data or credentials
*_results.json
api_scan_*.json
secret_scan_*.txt
dorks_*.json
cve-feed.json

# Backups
*.bak
*.bakup
*.backup
*.old
