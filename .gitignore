# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.whl

# Sensitive files
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
vault.dat
config.yaml
.env
.env.*
!.env.example

# API Keys & Secrets
*.secret
*.credential
*.token
keys_*.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

